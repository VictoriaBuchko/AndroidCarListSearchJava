<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SearchActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <AutoCompleteTextView
        android:id="@+id/acBrand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="Brand"
        android:textSize="15sp"
        android:completionThreshold="1"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <AutoCompleteTextView
        android:id="@+id/acModel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:hint="Model"
        android:textSize="15sp"
        android:completionThreshold="1"
        app:layout_constraintTop_toBottomOf="@id/acBrand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvYearLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="Year from"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/acModel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/spinnerYearFrom"/>

    <Spinner
        android:id="@+id/spinnerYearFrom"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/acModel"
        app:layout_constraintStart_toEndOf="@id/tvYearLabel"/>

    <TextView
        android:id="@+id/tvYearTo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="to"
        android:textSize="14sp"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@id/spinnerYearFrom"
        app:layout_constraintStart_toEndOf="@id/spinnerYearFrom"/>

    <Spinner
        android:id="@+id/spinnerYearTo"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@id/spinnerYearFrom"
        app:layout_constraintStart_toEndOf="@id/tvYearTo"/>

    <TextView
        android:id="@+id/tvCostLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Cost $"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/spinnerYearFrom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/etCostFrom"/>

    <EditText
        android:id="@+id/etCostFrom"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:hint="from"
        android:inputType="number"
        android:maxLines="1"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/spinnerYearFrom"
        app:layout_constraintStart_toEndOf="@id/tvCostLabel"/>

    <TextView
        android:id="@+id/tvCostDash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="14sp"
        android:layout_marginStart="6dp"
        app:layout_constraintBaseline_toBaselineOf="@id/etCostFrom"
        app:layout_constraintStart_toEndOf="@id/etCostFrom"/>

    <EditText
        android:id="@+id/etCostTo"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:hint="to"
        android:inputType="number"
        android:maxLines="1"
        android:textSize="14sp"
        app:layout_constraintBaseline_toBaselineOf="@id/etCostFrom"
        app:layout_constraintStart_toEndOf="@id/tvCostDash"/>

    <TextView
        android:id="@+id/tvCostError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="#FFD32F2F"
        android:text=""
        app:layout_constraintTop_toBottomOf="@id/etCostFrom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvMatchCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#FF555555"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvCostError"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnMatches"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 matches"
        android:enabled="false"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>